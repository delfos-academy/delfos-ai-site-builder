{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "if [[ \"$CLAUDE_TOOL_INPUT_FILE_PATH\" =~ \\.(ts|tsx)$ ]]; then pnpm exec tsc --noEmit -p tsconfig.json 2>&1 | head -50; fi",
            "description": "Roda typecheck depois de editar TS/TSX (head -50 para não inundar contexto)"
          },
          {
            "type": "command",
            "command": "if [[ \"$CLAUDE_TOOL_INPUT_FILE_PATH\" =~ \\.(ts|tsx|js|jsx)$ ]]; then pnpm exec eslint --fix \"$CLAUDE_TOOL_INPUT_FILE_PATH\" 2>&1 | tail -20; fi",
            "description": "Lint --fix no arquivo editado, mostra só warnings/errors restantes"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git status --porcelain | head -20",
            "description": "Mostra mudanças não-commitadas ao terminar turno"
          }
        ]
      }
    ]
  }
}
